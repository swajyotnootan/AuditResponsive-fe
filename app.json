{
  "expo": {
    "name": "AuditResponsive",
    "slug": "new",
    "owner": "chougules-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/IAlogo.png",
    "scheme": "auditresponsive",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to capture photos and videos.",
        "NSMicrophoneUsageDescription": "This app uses the microphone to record audio and video.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to attach images.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.nootan.auditresponsive"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/IAlogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.nootan.auditresponsive"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/IAlogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3776fe8b-4c75-4e4c-990f-85bb3f25a9a2"
      }
    }
  }
}
